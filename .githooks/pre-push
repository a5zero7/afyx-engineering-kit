#!/bin/sh
set -eu
root=$(git rev-parse --show-toplevel)
hygiene_script=
case "$(uname -s 2>/dev/null || true)" in
  MINGW*|MSYS*|CYGWIN*)
    common_dir=$(git rev-parse --path-format=absolute --git-common-dir)
    canonical_repo=$(cd "$common_dir/.." && pwd -P)
    hygiene_script="$(cd "$canonical_repo/.." && pwd -P)/_afyx-admin/Test-AfyxWorkspaceHygiene.ps1"
    if [ ! -f "$hygiene_script" ]; then
      echo "[pre-push] FAIL: canonical Windows workspace hygiene verifier is missing: $hygiene_script" >&2
      exit 1
    fi
    ;;
esac

# Hooks inherit repository-local Git variables from their caller. They are
# valid while resolving this hook's repository above, but must not leak into
# validators which create or inspect disposable repositories.
# AFYX_GIT_ENV_SANITIZE_BEGIN
git_local_env_vars=$(git rev-parse --local-env-vars)
for git_env_name in $git_local_env_vars; do
    unset "$git_env_name"
done
for git_env_name in $(env | sed -n 's/^\(GIT_CONFIG_\(COUNT\|PARAMETERS\|KEY_[0-9][0-9]*\|VALUE_[0-9][0-9]*\)\)=.*/\1/p'); do
    unset "$git_env_name"
done
# AFYX_GIT_ENV_SANITIZE_END

if [ -n "$hygiene_script" ]; then
    powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$hygiene_script" -RunSelfTests
fi

python "$root/scripts/validate-afyx-graph.py"
python "$root/scripts/audit-legacy-identity.py"
node "$root/scripts/verify-native-source-ownership.mjs"
cd "$root/afyx-graph/engine"
npm run build:clean
node scripts/verify-release-ready.mjs
npm test
npm run test:semantic
npm run test:smoke
npm pack --dry-run --json >/dev/null
