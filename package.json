{
  "name": "afyx-engineering-kit",
  "version": "1.2.1",
  "description": "Universal cross-platform CLI installer and lifecycle manager for AFYX Engineering Kit",
  "type": "module",
  "main": "./bin/afyx-engineering-kit.mjs",
  "bin": {
    "afyx": "./bin/afyx-engineering-kit.mjs",
    "afyx-engineering-kit": "./bin/afyx-engineering-kit.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "prepack": "node scripts/prepare-g6-package.mjs",
    "test:pack-json": "node --test scripts/tests/test_pack_json.mjs",
    "test": "node --test scripts/tests/test_npm_installer.mjs scripts/tests/test_macos_installer_parity.mjs scripts/tests/test_v101_regressions.mjs scripts/tests/test_v102_audit.mjs scripts/tests/test_b2_governance.mjs && python scripts/audit-legacy-identity.py"
  },
  "files": [
    ".afyx-source-revision",
    "bin/",
    "scripts/",
    "!scripts/tests/**",
    "!scripts/native-source-ownership.json",
    "!scripts/verify-native-source-ownership.mjs",
    "!scripts/verify-upstream-provenance.mjs",
    "!scripts/audit-legacy-identity.py",
    "skills/",
    "afyx-context/",
    "!afyx-context/test/**",
    "!afyx-context/test-fixtures/**",
    "!afyx-context/benchmark/**",
    "afyx-forge/",
    "!afyx-forge/test/**",
    "afyx-graph/afyx-graph.json",
    "afyx-graph/engine/release/afyx-graph-win32-x64.zip",
    "afyx-graph/engine/release/afyx-graph-linux-x64.tar.gz",
    "afyx-graph/engine/release/afyx-graph-darwin-arm64.tar.gz",
    "afyx-graph/engine/release/afyx-graph-darwin-x64.tar.gz",
    "afyx-graph/engine/release/SHA256SUMS",
    "afyx-graph/engine/release/RELEASE-MANIFEST.json",
    "afyx-graph/engine/scripts/distribution-product.json",
    "afyx-graph/engine/scripts/distribution-contract.mjs",
    "tools/",
    "!tools/afyx-usage-intelligence/tests/**",
    "install.ps1",
    "install.sh",
    "verify.ps1",
    "verify.sh",
    "update.ps1",
    "update.sh",
    "uninstall.ps1",
    "uninstall.sh",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "author": "Afif Mifbakhul Makruf <afifbendol@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/a5zero7/afyx-engineering-kit.git"
  },
  "keywords": [
    "afyx",
    "engineering-kit",
    "codex",
    "antigravity",
    "claude-code",
    "mcp",
    "graph",
    "context-engine"
  ]
}
