{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AfyxForgePlanResultV1",
  "type": "object",
  "required": [
    "contract",
    "version",
    "timestamp",
    "taskSummary",
    "classification",
    "adaptivePolicy",
    "guidance",
    "boundedExecution",
    "status"
  ],
  "properties": {
    "contract": {
      "type": "string",
      "const": "afyx-forge-plan/v1"
    },
    "version": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "taskSummary": {
      "type": "object",
      "required": ["title", "observedComplexity", "domainContext"],
      "properties": {
        "title": { "type": "string" },
        "observedComplexity": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "domainContext": { "type": "string" },
        "relevantFiles": { "type": "array", "items": { "type": "string" } }
      }
    },
    "classification": {
      "type": "object",
      "required": ["primaryCategory", "riskLevel", "confidence"],
      "properties": {
        "primaryCategory": {
          "type": "string",
          "enum": [
            "KNOWN_FILE_BUG",
            "UNKNOWN_DEFECT_DIAGNOSIS",
            "CROSS_MODULE_CHANGE",
            "SECURITY_SENSITIVE",
            "DATA_RELIABILITY",
            "NEGATIVE_SIMPLE"
          ]
        },
        "riskLevel": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
        "frameworks": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "adaptivePolicy": {
      "type": "object",
      "required": ["executionMode", "graphRouting", "contextEngine", "expertEngagement"],
      "properties": {
        "executionMode": {
          "type": "string",
          "enum": [
            "DIRECT_MINIMAL",
            "FOCUSED_INVESTIGATION",
            "STRUCTURAL_GRAPH_AWARE",
            "DOMAIN_SPECIALIST",
            "SECURITY_DEFENSE_IN_DEPTH"
          ]
        },
        "executionDirective": { "type": "string", "enum": ["DIRECT_SIMPLE", "SURGICAL_KNOWN_FILE", "FOCUSED_DIAGNOSIS", "CROSS_FILE", "DOMAIN_AWARE", "HIGH_RISK"] },
        "graphRouting": {
          "type": "string",
          "enum": ["BYPASS", "RECOMMENDED", "NOT_AVAILABLE", "BYPASS_USER_DISABLED", "BYPASS_PROVIDER_UNSUPPORTED"]
        },
        "graphRoutingReason": { "type": "string" },
        "contextEngine": {
          "type": "string",
          "enum": ["BYPASS_DEFAULT_OFF", "EXPLICIT_OPT_IN_REQUIRED", "ACTIVE", "NOT_AVAILABLE", "BYPASS_USER_DISABLED", "BYPASS_PROVIDER_UNSUPPORTED", "BYPASS_TASK_REFUSED"]
        },
        "expertEngagement": { "type": "string" }
      }
    },
    "guidance": {
      "type": "object",
      "required": [
        "investigationPriorities",
        "toolRecommendations",
        "validationScope",
        "completionCriteria"
      ],
      "properties": {
        "investigationPriorities": { "type": "array", "items": { "type": "string" } },
        "toolRecommendations": {
          "type": "object",
          "required": ["preferred", "avoided"],
          "properties": {
            "preferred": { "type": "array", "items": { "type": "string" } },
            "avoided": { "type": "array", "items": { "type": "string" } }
          }
        },
        "validationScope": { "type": "array", "items": { "type": "string" } },
        "completionCriteria": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirements": {
      "type": "object",
      "required": ["objective", "functionalRequirements", "affectedFiles", "constraints", "dependencies", "unknownAssumptions", "acceptanceCriteria", "scopeBoundaries", "riskLevel", "evidenceStatus"],
      "properties": {
        "objective": { "type": "string" },
        "riskLevel": { "type": "string" },
        "evidenceStatus": { "const": "REQUEST_TEXT_ONLY" },
        "functionalRequirements": { "type": "array", "items": { "type": "string" } },
        "affectedFiles": { "type": "array", "items": { "type": "string" } },
        "affectedComponents": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "unknownAssumptions": { "type": "array", "items": { "type": "string" } },
        "acceptanceCriteria": { "type": "array", "items": { "type": "string" } },
        "scopeBoundaries": { "type": "array", "items": { "type": "string" } }
      }
    },
    "executionPlan": {
      "type": "object",
      "required": ["status", "steps", "completionCriteria", "stoppingCondition"],
      "properties": {
        "status": { "type": "string", "enum": ["PROPOSED_NOT_EXECUTED", "REFUSED_NOT_EXECUTED"] },
        "steps": { "type": "array", "items": { "type": "object", "required": ["id", "dependsOn", "action"] } },
        "completionCriteria": { "type": "array", "items": { "type": "string" } },
        "stoppingCondition": { "type": "string" }
      }
    },
    "executionBudget": {
      "type": "object",
      "required": ["status", "observedToolCalls", "observedProviderTokens"],
      "properties": {
        "status": { "type": "string", "enum": ["RECOMMENDED_NOT_ENFORCED", "REFUSED_NOT_EXECUTED"] },
        "investigationDepth": { "type": "integer", "minimum": 1 },
        "toolCallCeiling": { "type": "integer", "minimum": 1 },
        "retryCeiling": { "type": "integer", "minimum": 0 },
        "elapsedTimeCeilingMs": { "type": "integer", "minimum": 1 },
        "validationIntensity": { "type": "string" },
        "contextGuideline": { "type": "string" },
        "observedToolCalls": { "type": ["integer", "null"] },
        "observedProviderTokens": { "type": ["integer", "null"] },
        "escalation": { "type": "string" }
      }
    },
    "boundedExecution": {
      "type": "object",
      "required": [
        "autonomousCodeExecution",
        "uncontrolledModelInvocation",
        "privilegeElevationAllowed",
        "governanceGateA8"
      ],
      "properties": {
        "autonomousCodeExecution": { "type": "boolean" },
        "uncontrolledModelInvocation": { "type": "boolean" },
        "privilegeElevationAllowed": { "type": "boolean" },
        "governanceGateA8": { "type": "string" }
      }
    },
    "status": {
      "type": "string",
      "enum": ["PLANNED", "PREPARED", "VALIDATED", "REFUSED_UNSAFE"]
    },
    "refusalReason": { "type": "string" }
  }
}

